# Lead intake delivery — POST /api/leads routes submissions from the
# Request-a-Quote and Credit Application forms. Configure ONE channel.
# If none is set, submissions are written to the server log ONLY and the API
# returns an error so users are told to phone/email instead of seeing a false
# "we got it" confirmation.

# --- Option 1: Email via Resend (https://resend.com) ---
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# LEADS_TO_EMAIL=fuels@tswanapetroleum.co.za
# LEADS_FROM_EMAIL=website@tswanapetroleum.co.za   # must be a Resend-verified sender

# --- Option 2: Generic webhook (Slack incoming webhook, Zapier, CRM, n8n) ---
# LEADS_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz


# Analytics & marketing tags — loaded ONLY after the visitor grants the
# matching cookie consent (see the cookie banner). Leave unset to load nothing.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX          # Google Analytics 4 -> "analytics" consent
# NEXT_PUBLIC_META_PIXEL=123456789012345  # Meta Pixel        -> "marketing" consent
